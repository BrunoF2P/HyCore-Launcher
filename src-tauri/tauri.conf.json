{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyCore",
  "version": "0.1.4",
  "identifier": "com.hycore.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BrunoF2P/hycore/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFREIwNkQ0RTE4NUY3RjQKUldUMDk0WGgxQWJidm5NR1NuaW9xdm9LOGl5dXdkNjU3WjNOZGNjOVFaUVhrRjcyRTA2MndxenoK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "HyCore Launcher",
        "width": 1200,
        "height": 700,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/hycore/game/Assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}